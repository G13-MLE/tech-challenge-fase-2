#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
export PRE_COMMIT_HOME="$REPO_ROOT/.pre-commit-cache"
export UV_PYTHON_INSTALL_DIR="$REPO_ROOT/.uv-python"

PYTHON="$REPO_ROOT/.venv/Scripts/python.exe"

if [ ! -x "$PYTHON" ]; then
  echo "Python environment not found. Run: make setup" >&2
  exit 1
fi

exec "$PYTHON" -mpre_commit hook-impl \
  --config=.pre-commit-config.yaml \
  --hook-type=pre-commit \
  --hook-dir "$REPO_ROOT/.githooks" \
  -- "$@"
