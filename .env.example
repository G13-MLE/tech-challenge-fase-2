# =============================================================================
# Ambiente
# =============================================================================
# type: enum[development,production] | required: no | default: development
ENV=development  # development | production

# =============================================================================
# Reprodutibilidade
# =============================================================================
# type: int | required: no | default: 42 | validation: >= 0
RANDOM_SEED=42

# =============================================================================
# Caminhos
# =============================================================================
# type: path | required: no | default: data/ | validation: path valido
DATA_DIR=data/
# type: path | required: no | default: models/ | validation: path valido
MODELS_DIR=models/
# type: path | required: no | default: configs/ | validation: path valido
CONFIGS_DIR=configs/

# =============================================================================
# MLflow
# =============================================================================
# type: url | required: no | default: http://localhost:5000 | validation: URI valida (http/https/file)
MLFLOW_TRACKING_URI=http://localhost:5000
# type: str | required: no | default: tech-challenge-fase2 | validation: nao vazio
MLFLOW_EXPERIMENT_NAME=tech-challenge-fase2

# =============================================================================
# DVC
# =============================================================================
# type: str | required: no | default: vazio | validation: se preenchido, URI valida (s3://, gs://, ssh://)
DVC_REMOTE_URL=

# =============================================================================
# Modelo
# =============================================================================
# type: float | required: no | default: 0.001 | validation: > 0
LEARNING_RATE=0.001
# type: int | required: no | default: 64 | validation: > 0
BATCH_SIZE=64
# type: int | required: no | default: 10 | validation: > 0
EPOCHS=10
# type: int | required: no | default: 64 | validation: > 0
EMBEDDING_DIM=64
