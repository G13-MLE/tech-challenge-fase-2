# =============================================================================
# Ambiente
# =============================================================================
ENV=development  # development | production

# =============================================================================
# Reprodutibilidade
# =============================================================================
RANDOM_SEED=42

# =============================================================================
# Caminhos
# =============================================================================
DATA_DIR=data/
MODELS_DIR=models/
CONFIGS_DIR=configs/

# =============================================================================
# MLflow
# =============================================================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=tech-challenge-fase2

# =============================================================================
# DVC
# =============================================================================
# Caminho local da pasta do OneDrive usada como remote DVC.
# Cada membro preenche com o seu caminho sincronizado pelo cliente OneDrive.
#   macOS:   /Users/<usuario>/OneDrive - FIAP/techchallenge-fase2/dvcstore
#   Windows: C:/Users/<usuario>/OneDrive - FIAP/techchallenge-fase2/dvcstore
#   Linux:   /home/<usuario>/OneDrive/techchallenge-fase2/dvcstore
# Deixe vazio apenas em ambiente totalmente self-contained (nao recomendado
# para o fase-2, pois o dataset RetailRocket e ~1.4 GB).
DVC_ONEDRIVE_REMOTE_URL=

# =============================================================================
# Kaggle (download do dataset RetailRocket)
# =============================================================================
# Crie em https://www.kaggle.com/settings -> API -> Create New Token
# Baixe o kaggle.json e use os valores abaixo.
KAGGLE_USERNAME=
KAGGLE_KEY=

# =============================================================================
# Modelo
# =============================================================================
LEARNING_RATE=0.001
BATCH_SIZE=64
EPOCHS=10
EMBEDDING_DIM=64
