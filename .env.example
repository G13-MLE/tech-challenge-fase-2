# =============================================================================
# Ambiente
# =============================================================================
ENV=development  # development | production

# =============================================================================
# Reprodutibilidade
# =============================================================================
RANDOM_SEED=42

# =============================================================================
# Caminhos
# =============================================================================
DATA_DIR=data/
MODELS_DIR=models/
CONFIGS_DIR=configs/

# =============================================================================
# MLflow Server
# =============================================================================
MLFLOW_PORT=5000
MLFLOW_WORKERS=2

# =============================================================================
# MLflow Client (Python)
# =============================================================================
# URL do servidor MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# Nome do experimento para NCF (Neural Collaborative Filtering / MLP)
MLFLOW_NCF_EXPERIMENT_NAME=tech-challenge-ncf

# Nome do experimento para EASE^ (candidato a campeao)
MLFLOW_EASE_EXPERIMENT_NAME=tech-challenge-ease

# Nome do experimento para baselines sklearn (ItemKNN, LogisticRegression)
MLFLOW_BASELINE_EXPERIMENT_NAME=tech-challenge-baselines

# Nome generico do experimento (fallback para pipelines sem variavel especifica)
MLFLOW_EXPERIMENT_NAME=tech-challenge-fase2

# =============================================================================
# PostgreSQL (backend store do MLflow)
# =============================================================================
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_secure_password_2024
POSTGRES_DB=mlflow_db

# =============================================================================
# MinIO (artifact store S3-compatible)
# =============================================================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret_key_2024

# =============================================================================
# AWS credentials (devem ser iguais ao MinIO para acesso aos artefatos)
# =============================================================================
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_secret_key_2024

# =============================================================================
# DVC
# =============================================================================
# Caminho local da pasta do OneDrive usada como remote DVC.
# Cada membro preenche com o seu caminho sincronizado pelo cliente OneDrive.
#   macOS:   /Users/<usuario>/OneDrive - FIAP/techchallenge-fase2/dvcstore
#   Windows: C:/Users/<usuario>/OneDrive - FIAP/techchallenge-fase2/dvcstore
#   Linux:   /home/<usuario>/OneDrive/techchallenge-fase2/dvcstore
# Deixe vazio apenas em ambiente totalmente self-contained (não recomendado
# para o fase-2, pois o dataset RetailRocket é ~1.4 GB).
DVC_ONEDRIVE_REMOTE_URL=

# =============================================================================
# Kaggle (download do dataset RetailRocket)
# =============================================================================
# Crie em https://www.kaggle.com/settings -> API -> Create New Token
# Baixe o kaggle.json e use os valores abaixo.
KAGGLE_USERNAME=
KAGGLE_KEY=

# =============================================================================
# Modelo
# =============================================================================
LEARNING_RATE=0.001
BATCH_SIZE=64
EPOCHS=10
EMBEDDING_DIM=64
TEST_RATIO=0.2
RECOMMENDATION_LIMIT=20
